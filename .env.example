## Copy to .env and fill values.

# App
APP_ENV=dev
AUTH_SESSION_TTL_HOURS=24
AUTH_CODE_TTL_MINUTES=15

# Gmail OAuth files for auth emails (MVP)
GMAIL_TOKEN_FILE=token.json
GMAIL_DEFAULT_SENDER=me

# Database (required)
DB_HOST=localhost
DB_PORT=5432
DB_USER=romantic_user
DB_PASSWORD=your_password
DB_NAME=romantic_storage


