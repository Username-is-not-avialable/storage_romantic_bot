## Copy to .env and fill values.

# App
APP_ENV=dev
AUTH_SESSION_TTL_HOURS=24
AUTH_CODE_TTL_MINUTES=15

# Gmail OAuth files for auth emails (MVP)
GMAIL_TOKEN_FILE=api/token.json
GMAIL_DEFAULT_SENDER=me

# Database (required for API)
DB_HOST=localhost
DB_PORT=5432
DB_USER=romantic_user
DB_PASSWORD=your_password
DB_NAME=romantic_storage

# VK: shared secret for POST/GET /api/integrations/vk/* (API + bot must match).
# Leave empty only if you do not use the bot; integration routes then return 503.
VK_BOT_SECRET=generate_a_long_random_string
# One-time link code TTL (minutes) for POST /api/auth/vk-link/request_code
VK_LINK_TTL_MINUTES=15

# VK bot (docker-compose service `bot`; also used when compose substitutes ${VAR})
VK_GROUP_TOKEN=
VK_GROUP_ID=
# Public URL that the VK bot sends to users for getting a one-time VK link code.
VK_LINK_PAGE_URL=http://localhost:8080/vk-link
# In compose, API_BASE_URL is set to http://api:8000 for the bot. Override if you run the bot outside Docker.
# API_BASE_URL=http://localhost:8100
